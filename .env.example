# Copy this file to "apps/api/.env" and fill in real values.
# NEVER put real passwords in GitHub. ".env" files are ignored by git on purpose.

# Owner connection: used ONLY to set up/upgrade the database (migrations).
DATABASE_OWNER_URL=postgres://arscio_owner:dev_only_password@localhost:5432/arscio

# App connection: what the running server uses. This user is locked down
# so it can only ever see one school's data at a time.
DATABASE_URL=postgres://arscio_app:dev_app_password@localhost:5432/arscio
APP_DB_PASSWORD=dev_app_password

# Long random secret for signing login tokens (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# "console" = OTPs are printed in the server log (development only).
# Later: "msg91" or another Indian SMS provider with DLT registration.
OTP_PROVIDER=console

PORT=4000

# Only needed to try the phone apps in a web browser during development,
# e.g. http://localhost:8081. Leave empty in production.
CORS_ORIGINS=

# Send app notifications to phones (through Expo's push service). "true" in production.
PUSH_ENABLED=false
